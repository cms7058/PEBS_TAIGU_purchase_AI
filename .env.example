# 首次启动必须修改。6–200 个字符；不要把实际 .env 提交到仓库。
BOOTSTRAP_ADMIN_PASSWORD=
HTTP_ADDR=:8080
DATA_DIR=./data
# 本地 HTTP 为 false；经过 HTTPS 反向代理的云端部署设为 true。
COOKIE_SECURE=false
# runtime-core：最小镜像；runtime-pdf：增加PDF原版式渲染。
RUNTIME_TARGET=runtime-core
# 支持 Chat Completions 兼容接口。留空时明确显示示例回放。
# BASE_URL 应包含 /v1，不包含 /chat/completions。
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_MAX_CALLS=100
